# Environment Files - NEVER commit real credentials
# Commit only the .env.*.example template files instead
.env
.env.dev
.env.uat
.env.prod
.env.test
.env.local
.env.*.local

# Google Drive Credentials - NEVER commit
Backend/drive_service_account.json
Backend/.gdrive_token.json
drive_service_account.json
.gdrive_token.json

