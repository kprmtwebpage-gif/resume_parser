# Copy this file to .env.uat and fill in real values
APP_ENV=uat
DB_NAME=resume_uat
DB_USER=postgres
DB_PASSWORD=<your-uat-password>
DB_HOST=database
DB_PORT=5432
GDRIVE_FOLDER_ID=<your-google-drive-folder-id>

# LLM / Groq — master switch (flip to true + add key to enable)
USE_LLM=false
OPENAI_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.1-8b-instant
