# ─────────────────────────────────────────────────────────
# Docker environment configuration for resume_parser_dev
# Copy this file to .env.docker and fill in the values.
# Do NOT commit real credentials to version control.
# ─────────────────────────────────────────────────────────

# Database (matches docker-compose db service defaults)
DB_NAME=resume_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# New table names (adjust if your schema differs)
NEW_CANDIDATES_TABLE=candidate_profile
NEW_SKILLS_TABLE=candidate_skills_profile

# Google Drive integration (optional)
# RESUME_INPUT_MODE=gdrive

# Server
API_HOST=0.0.0.0
API_PORT=8000
SERVE_FRONTEND=1

# Chatbot (optional – leave blank to disable)
# OPENAI_API_KEY=sk-...
