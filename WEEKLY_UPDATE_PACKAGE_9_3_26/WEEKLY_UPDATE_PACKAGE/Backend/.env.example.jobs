# ================================================================
# DATABASE CONFIGURATION FOR JOBS TABLE SETUP
# ================================================================
# Copy this file to .env and update with your database credentials
# 
# Example:
#   cp .env.example .env
#   nano .env  (or use your preferred editor)
# ================================================================

# Database Host (usually localhost for development)
DB_HOST=localhost

# Database Port (default PostgreSQL port is 5432)
DB_PORT=5432

# Database Name
DB_NAME=your_database_name

# Database User
DB_USER=your_username

# Database Password
DB_PASSWORD=your_password

# ================================================================
# NOTES:
# ================================================================
# 1. Never commit the .env file to version control
# 2. Add .env to your .gitignore file
# 3. Keep credentials secure and rotate passwords regularly
# 4. Use different credentials for development and production
# ================================================================
