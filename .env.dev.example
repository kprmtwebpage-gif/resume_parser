# Copy this file to .env.dev and fill in real values
APP_ENV=dev
DB_NAME=resume_dev
DB_USER=postgres
DB_PASSWORD=<your-dev-password>
DB_HOST=database
DB_PORT=5432
GDRIVE_FOLDER_ID=<your-google-drive-folder-id>

# LLM / Groq — master switch (flip to true + add key to enable)
USE_LLM=false
OPENAI_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.1-8b-instant

# SMTP — for sending emails (Gmail: use App Password, not regular password)
# To generate an App Password:
#   1. Go to https://myaccount.google.com/apppasswords
#   2. Select "Mail" and "Windows Computer"
#   3. Copy the 16-char password and paste below (no spaces)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# SMTP — Outlook (use App Password)
OUTLOOK_SMTP_HOST=smtp.office365.com
OUTLOOK_SMTP_PORT=587
OUTLOOK_SMTP_USER=
OUTLOOK_SMTP_PASSWORD=
