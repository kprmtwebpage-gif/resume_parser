# =============================================================
# Dockerfile.ingestion  –  Resume Ingestion / Parser Service
# =============================================================
FROM python:3.11-slim

LABEL maintainer="KPRMT Global Solutions"
LABEL service="resume-ingestion"

# System libraries: tesseract (OCR), poppler (PDF), libpq (PostgreSQL)
RUN apt-get update && apt-get install -y --no-install-recommends \
    tesseract-ocr \
    poppler-utils \
    libpq-dev \
    gcc \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python dependencies
COPY Backend/requirements.txt ./Backend/requirements.txt
RUN pip install --no-cache-dir -r Backend/requirements.txt

# Copy backend source code
COPY Backend/ ./Backend/

# Copy root-level ingestion entry-point
COPY resume_ingestion_service.py ./

# Persist parsed resume cache via volume mount at runtime
RUN mkdir -p /app/Backend/resumes_cache

ENV PYTHONUNBUFFERED=1

CMD ["python", "resume_ingestion_service.py", "--watch"]
